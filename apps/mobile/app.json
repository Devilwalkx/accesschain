{
  "expo": {
    "name": "AccessChain",
    "slug": "accesschain",
    "version": "0.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "invalid.placeholder.accesschain"
    },
    "android": {
      "package": "invalid.placeholder.accesschain",
      "permissions": [
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to attach to your report. Metadata is removed before it is used.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Optional: use your current location as the start of a journey. It is only read when you tap the button and is not tracked in the background.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "AccessChain (synthetic demo)",
      "shortName": "AccessChain",
      "backgroundColor": "#ffffff",
      "themeColor": "#0b3d91",
      "lang": "en-GB"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ]
  }
}
