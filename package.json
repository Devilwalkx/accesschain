{
  "name": "accesschain",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "test": "npm test -w @accesschain/core -w @accesschain/db -w @accesschain/mobile",
    "typecheck": "npm run typecheck -w @accesschain/core && npm run typecheck -w @accesschain/mobile",
    "demo": "npm run demo -w @accesschain/core",
    "e2e": "npm run build:web -w @accesschain/mobile && npm test -w @accesschain/e2e"
  }
}
